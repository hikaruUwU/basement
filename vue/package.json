{
  "name": "frontier-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --reporter=append-only -r --parallel dev",
    "build": "pnpm -r --parallel --stream run build:production && node scripts/collect-dist.ts",
    "build:production": "pnpm --reporter=append-only -r build:production && node scripts/collect-dist.ts",
    "build:development": "pnpm --reporter=append-only -r build:development && node scripts/collect-dist.ts",
    "postbuild": "node scripts/collect-dist.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vue/language-server": "^3.3.13",
    "@vue/typescript-plugin": "^3.3.13",
    "prettier": "^3.9.10"
  }
}
