{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist", "rsbuild.config.ts"]
}
