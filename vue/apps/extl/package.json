{
  "name": "extl",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "rsbuild dev --open --env-mode development --host 127.0.0.1 --port 3100",
    "dev": "rsbuild dev --open --env-mode development --host 0.0.0.0 --port 3100",
    "dev:debug": "cross-env DEBUG=rsbuild pnpm dev",
    "build": "tsc -b && rsbuild build --env-mode production",
    "build:production": "tsc -b && rsbuild build --env-mode production",
    "build:development": "tsc -b && rsbuild build --env-mode development",
    "build:rsdoctor": "cross-env RSDOCTOR=true rsbuild build",
    "preview": "rsbuild preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.20.0",
    "nprogress": "^0.2.0",
    "radash": "^12.1.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.14",
    "@rsbuild/plugin-image-compress": "^1.3.4",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsbuild/plugin-vue-jsx": "^2.0.1",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "cross-env": "^10.1.0",
    "rsbuild-plugin-compression": "^0.1.2",
    "typescript": "7.0.2",
    "unplugin": "^3.4.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0"
  }
}
