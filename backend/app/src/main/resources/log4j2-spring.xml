<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="LOG_PATH">/app/logs</Property>
        <Property name="FILE_NAME">app</Property>
    </Properties>

    <Appenders>

        <!-- ========================= -->
        <!-- Development Console       -->
        <!-- ========================= -->
        <Console name="CONSOLE_DEV" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:LogEvent.json">
                <EventTemplateAdditionalField
                        key="service"
                        value="backend"/>
                <EventTemplateAdditionalField
                        key="environment"
                        value="dev"/>
            </JsonTemplateLayout>
        </Console>

        <!-- ========================= -->
        <!-- Production Console        -->
        <!-- ========================= -->
        <Console name="CONSOLE_PROD" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:LogEvent.json">
                <EventTemplateAdditionalField
                        key="service"
                        value="backend"/>
                <EventTemplateAdditionalField
                        key="environment"
                        value="prod"/>
            </JsonTemplateLayout>
        </Console>

        <!-- ========================= -->
        <!-- Development INFO File     -->
        <!-- ========================= -->
        <RollingFile
                name="ROLLING_FILE_INFO_DEV"
                fileName="${LOG_PATH}/${FILE_NAME}.log"
                filePattern="${LOG_PATH}/${FILE_NAME}-%d{yyyy-MM-dd}-%i.log"
                immediateFlush="true">

            <JsonTemplateLayout eventTemplateUri="classpath:LogEvent.json">
                <EventTemplateAdditionalField
                        key="service"
                        value="backend"/>
                <EventTemplateAdditionalField
                        key="environment"
                        value="dev"/>
            </JsonTemplateLayout>

            <Filters>
                <!-- Exclude WARN and above -->
                <ThresholdFilter
                        level="WARN"
                        onMatch="DENY"
                        onMismatch="NEUTRAL"/>

                <!-- Accept INFO and above -->
                <ThresholdFilter
                        level="INFO"
                        onMatch="ACCEPT"
                        onMismatch="DENY"/>
            </Filters>

            <Policies>
                <TimeBasedTriggeringPolicy
                        interval="1"
                        modulate="true"/>
                <SizeBasedTriggeringPolicy
                        size="100MB"/>
            </Policies>

            <DefaultRolloverStrategy>
                <Delete
                        basePath="${LOG_PATH}"
                        maxDepth="1">
                    <IfFileName
                            glob="app-????-??-??-*.log"/>
                    <IfLastModified
                            age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>

        </RollingFile>

        <!-- ========================= -->
        <!-- Development WARN / ERROR -->
        <!-- ========================= -->
        <RollingFile
                name="ROLLING_FILE_ERROR_DEV"
                fileName="${LOG_PATH}/${FILE_NAME}-error.log"
                filePattern="${LOG_PATH}/${FILE_NAME}-error-%d{yyyy-MM-dd}-%i.log"
                immediateFlush="true">

            <JsonTemplateLayout eventTemplateUri="classpath:LogEvent.json">
                <EventTemplateAdditionalField
                        key="service"
                        value="backend"/>
                <EventTemplateAdditionalField
                        key="environment"
                        value="dev"/>
            </JsonTemplateLayout>

            <Filters>
                <!-- Accept WARN and above -->
                <ThresholdFilter
                        level="WARN"
                        onMatch="ACCEPT"
                        onMismatch="DENY"/>
            </Filters>

            <Policies>
                <TimeBasedTriggeringPolicy
                        interval="1"
                        modulate="true"/>
                <SizeBasedTriggeringPolicy
                        size="100MB"/>
            </Policies>

            <DefaultRolloverStrategy>
                <Delete
                        basePath="${LOG_PATH}"
                        maxDepth="1">
                    <IfFileName
                            glob="app-error-????-??-??-*.log"/>
                    <IfLastModified
                            age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>

        </RollingFile>

        <!-- ========================= -->
        <!-- Production INFO File      -->
        <!-- ========================= -->
        <RollingFile
                name="ROLLING_FILE_INFO_PROD"
                fileName="${LOG_PATH}/${FILE_NAME}.log"
                filePattern="${LOG_PATH}/${FILE_NAME}-%d{yyyy-MM-dd}-%i.log"
                immediateFlush="true">

            <JsonTemplateLayout eventTemplateUri="classpath:LogEvent.json">
                <EventTemplateAdditionalField
                        key="service"
                        value="backend"/>
                <EventTemplateAdditionalField
                        key="environment"
                        value="prod"/>
            </JsonTemplateLayout>

            <Filters>
                <!-- Exclude WARN and above -->
                <ThresholdFilter
                        level="WARN"
                        onMatch="DENY"
                        onMismatch="NEUTRAL"/>

                <!-- Accept INFO and above -->
                <ThresholdFilter
                        level="INFO"
                        onMatch="ACCEPT"
                        onMismatch="DENY"/>
            </Filters>

            <Policies>
                <TimeBasedTriggeringPolicy
                        interval="1"
                        modulate="true"/>
                <SizeBasedTriggeringPolicy
                        size="100MB"/>
            </Policies>

            <DefaultRolloverStrategy>
                <Delete
                        basePath="${LOG_PATH}"
                        maxDepth="1">
                    <IfFileName
                            glob="app-????-??-??-*.log"/>
                    <IfLastModified
                            age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>

        </RollingFile>

        <!-- ========================= -->
        <!-- Production WARN / ERROR  -->
        <!-- ========================= -->
        <RollingFile
                name="ROLLING_FILE_ERROR_PROD"
                fileName="${LOG_PATH}/${FILE_NAME}-error.log"
                filePattern="${LOG_PATH}/${FILE_NAME}-error-%d{yyyy-MM-dd}-%i.log"
                immediateFlush="true">

            <JsonTemplateLayout eventTemplateUri="classpath:LogEvent.json">
                <EventTemplateAdditionalField
                        key="service"
                        value="backend"/>
                <EventTemplateAdditionalField
                        key="environment"
                        value="prod"/>
            </JsonTemplateLayout>

            <Filters>
                <!-- Accept WARN and above -->
                <ThresholdFilter
                        level="WARN"
                        onMatch="ACCEPT"
                        onMismatch="DENY"/>
            </Filters>

            <Policies>
                <TimeBasedTriggeringPolicy
                        interval="1"
                        modulate="true"/>
                <SizeBasedTriggeringPolicy
                        size="100MB"/>
            </Policies>

            <DefaultRolloverStrategy>
                <Delete
                        basePath="${LOG_PATH}"
                        maxDepth="1">
                    <IfFileName
                            glob="app-error-????-??-??-*.log"/>
                    <IfLastModified
                            age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>

        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- ========================= -->
        <!-- Development               -->
        <!-- ========================= -->
        <SpringProfile name="dev">

            <Root
                    level="INFO"
                    includeLocation="false">

                <AppenderRef ref="CONSOLE_DEV"/>
                <AppenderRef ref="ROLLING_FILE_INFO_DEV"/>
                <AppenderRef ref="ROLLING_FILE_ERROR_DEV"/>

            </Root>

        </SpringProfile>

        <!-- ========================= -->
        <!-- Production                -->
        <!-- ========================= -->
        <SpringProfile name="prod">

            <Root
                    level="INFO"
                    includeLocation="false">

                <AppenderRef ref="CONSOLE_PROD"/>
                <AppenderRef ref="ROLLING_FILE_INFO_PROD"/>
                <AppenderRef ref="ROLLING_FILE_ERROR_PROD"/>

            </Root>

        </SpringProfile>

    </Loggers>

</Configuration>